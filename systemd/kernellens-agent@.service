[Unit]
Description=KernelLens monitoring agent (run %i)

[Service]
Type=simple
ExecStart=/usr/local/bin/kernellens-agent \
  --out /var/log/kernellens/%i.jsonl \
  --node %H \
  --interval-ms 1000 \
  --bpf-obj /usr/local/lib/kernellens/kernellens.bpf.o
LogsDirectory=kernellens
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=10
# CAP_BPF/CAP_PERFMON exist from kernel 5.8; CAP_SYS_ADMIN covers older ones.
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_DAC_READ_SEARCH
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
